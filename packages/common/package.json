{
  "name": "@zanobijs/common",
  "version": "2.0.0-beta.1",
  "description": "Zanobi - modern, small, powerful node.js lambda framework (@common)",
  "keywords": [],
  "author": "John Edison Cortes Rivera [Devdroide] <johne.aplicativos@gmail.com>",
  "license": "ZanobiJS Usage License \n\n Review the LICENSE file.\n\n Revise el archivo de LICENCIA.",
  "main": "./lib/cjs/index.js",
  "module": "./lib/esm/index.js",
  "typings": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "import": "./lib/esm/index.js",
      "require": "./lib/cjs/index.js"
    },
    "./utils": {
      "types": "./lib/types/utils/index.d.ts",
      "import": "./lib/esm/utils/index.js",
      "require": "./lib/cjs/utils/index.js"
    },
    "./utils/constants": {
      "types": "./lib/types/utils/constants.d.ts",
      "import": "./lib/esm/utils/constants.js",
      "require": "./lib/cjs/utils/constants.js"
    },
    "./utils/shared.utils": {
      "types": "./lib/types/utils/shared.utils.d.ts",
      "import": "./lib/esm/utils/shared.utils.js",
      "require": "./lib/cjs/utils/shared.utils.js"
    },
    "./exceptions/runtime.exception": {
      "types": "./lib/types/exceptions/runtime.exception.d.ts",
      "import": "./lib/esm/exceptions/runtime.exception.js",
      "require": "./lib/cjs/exceptions/runtime.exception.js"
    },
    "./services/base.logger.service": {
      "types": "./lib/types/services/base.logger.service.d.ts",
      "import": "./lib/esm/services/base.logger.service.js",
      "require": "./lib/cjs/services/base.logger.service.js"
    }
  },
  "files": [
    "lib"
  ],
  "homepage": "https://zanobijs.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devdroide/ZanobiJS.git",
    "directory": "packages/common"
  },
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/devdroide/ZanobiJS/issues"
  },
  "dependencies": {
    "reflect-metadata": "^0.1.13",
    "tslib": "^2.8.1"
  },
  "engines": {
    "node": ">= 22.13.0"
  },
  "gitHead": "201c1b2c289b80d94fcc899dc087b1d95de801d7"
}
